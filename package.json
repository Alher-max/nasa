{
  "name": "karbontani",
  "version": "1.0.0",
  "private": true,
  "workspaces": [
    "frontend"
  ],
  "scripts": {
    "dev": "concurrently -k -n WEB,API -c cyan,green \"npm run dev --workspace frontend\" \"python -m uvicorn backend.main:app --reload --port 8000\"",
    "dev:frontend": "npm run dev --workspace frontend",
    "dev:backend": "python -m uvicorn backend.main:app --reload --port 8000",
    "start:frontend": "npm run start --workspace frontend",
    "start:backend": "python -m uvicorn backend.main:app --port 8000"
  },
  "devDependencies": {
    "concurrently": "^9.2.1"
  }
}
